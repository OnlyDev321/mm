{
  "model": "/workspace/models/D1",
  "use_hf": true,
  "model_type": "qwen3_vl",
  "template": "qwen3_vl",
  "torch_dtype": "bfloat16",
  "bf16": true,
  "attn_impl": "sdpa",
  "train_type": "lora",
  "freeze_vit": true,
  "freeze_aligner": true,
  "target_regex": "model\\.language_model\\.layers\\.\\d+\\.(self_attn\\.(q|k|v|o)_proj|mlp\\.(gate|up|down)_proj)",
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_bias": "none",
  "optim": "adamw_torch",
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_epsilon": 1e-08,
  "learning_rate": 5e-06,
  "lr_scheduler_type": "cosine",
  "warmup_ratio": 0.03,
  "weight_decay": 0,
  "max_grad_norm": 1,
  "num_train_epochs": 2,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "gradient_checkpointing": true,
  "max_length": 10240,
  "truncation_strategy": "raise",
  "loss_scale": "default",
  "split_dataset_ratio": 0,
  "seed": 3407,
  "data_seed": 3407,
  "dataset_shuffle": false,
  "train_dataloader_shuffle": false,
  "dataloader_drop_last": false,
  "strict": true,
  "logging_steps": 1,
  "eval_strategy": "no",
  "save_strategy": "epoch",
  "save_only_model": true,
  "save_total_limit": 1,
  "load_best_model_at_end": false,
  "add_version": false,
  "report_to": "none",
  "rlhf_type": "dpo",
  "loss_type": "sigmoid",
  "beta": 0.1,
  "rpo_alpha": 1.0,
  "remove_unused_columns": false,
  "disable_dropout": false,
  "ref_model": null,
  "ref_adapters": [],
  "adapters": [],
  "resume_from_checkpoint": null,
  "push_to_hub": false,
  "dataset": [
    "data/d2p_pairs_swift.jsonl"
  ]
